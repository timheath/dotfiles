# Set LSCOLORS (Omarchy keeps its own ls/eza colors)
if ! is-omarchy; then
  eval "$(dircolors "$DOTFILES_DIR"/system/dir_colors)"
fi

# config/nvim diverges from Omarchy's; flag its updates for review
if is-omarchy && ! omarchy-nvim-diff --check; then
  echo "omarchy-nvim was updated; run omarchy-nvim-diff to review"
fi

